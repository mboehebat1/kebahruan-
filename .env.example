# Salin ke environment server / Vercel — JANGAN commit nilai aslinya.
# Passcode awal akun "dosen" saat database pertama dibuat (minimal 8 karakter, gunakan yang kuat & acak).
# Bila kosong, server membuat passcode acak dan mencetaknya SEKALI di log saat pertama jalan.
MQ_DOSEN_PASS=
# Lokasi database SQLite. Kosongkan untuk default (backend/macroquest.db; di Vercel: /tmp/macroquest.db).
MQ_DB=
# Set 1 HANYA untuk demo lokal: membuat akun contoh 1001/ahmad1 & 1002/budi22 pada database baru.
MQ_SEED_DEMO=0
